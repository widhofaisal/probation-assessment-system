<?php
/**
 * env.local.php — konfigurasi untuk server yang tidak mengizinkan putenv().
 *
 * Sebagian hosting bersama (shared hosting) mematikan putenv(), sehingga berkas
 * `.env` biasa tidak terbaca. Berkas ini mengisi $_ENV secara langsung, jadi
 * tetap bekerja di lingkungan tersebut.
 *
 * CARA PAKAI
 *   1. Salin berkas ini menjadi `env.local.php`.
 *   2. Letakkan di:
 *        - Server : di folder yang sama dengan index.php (mis. htdocs/ atau public_html/).
 *        - Lokal  : di akar proyek, sejajar composer.json — opsional, di lokal
 *                   lebih lazim memakai `.env` biasa.
 *   3. Isi setiap nilai di bawah sesuai server Anda.
 *   4. JANGAN commit berkas ini — sudah masuk .gitignore.
 *
 * Dimuat oleh public/index.php sebelum CodeIgniter boot.
 *
 * Kalau server Anda mengizinkan putenv() (VPS, cPanel pada umumnya), abaikan
 * berkas ini dan pakai `.env` — lihat .env.example.
 */

$_ENV['CI_ENVIRONMENT'] = 'production';

// ---------------------------------------------------------------- APP -----
// baseURL wajib diakhiri garis miring.
$_ENV['app.baseURL']  = 'https://hrd.perusahaan-anda.co.id/';
$_ENV['app.indexPage'] = '';

// Set 'true' setelah HTTPS aktif, agar semua akses dipaksa lewat HTTPS.
$_ENV['app.forceGlobalSecureRequests'] = 'false';
$_ENV['app.CSPEnabled'] = 'false';

// ----------------------------------------------------------- DATABASE -----
$_ENV['database.default.hostname']  = 'localhost';
$_ENV['database.default.database']  = 'NAMA_DATABASE';
$_ENV['database.default.username']  = 'USER_DATABASE';
$_ENV['database.default.password']  = 'PASSWORD_DATABASE';
$_ENV['database.default.DBDriver']  = 'MySQLi';
$_ENV['database.default.DBPrefix']  = '';
$_ENV['database.default.port']      = '3306';
$_ENV['database.default.charset']   = 'utf8mb4';
$_ENV['database.default.collation'] = 'utf8mb4_unicode_ci';

// ---------------------------------------------------------- ENCRYPTION ----
// WAJIB DIISI, dan HARUS unik untuk instalasi ini.
//
// Sengaja dibiarkan kosong. Kunci contoh yang bisa disalin apa adanya justru
// berbahaya: kalau dipakai apa adanya, setiap instalasi yang memakai berkas
// contoh yang sama akan berbagi kunci enkripsi yang identik.
//
// Cara membuat (jalankan di komputer lokal, lalu salin hasilnya ke sini):
//     php spark key:generate --show
//
// Atau bangkitkan 32 karakter acak dengan cara apa pun yang Anda percayai.
$_ENV['encryption.key'] = '';

// ------------------------------------------------------------- SESSION ----
$_ENV['session.driver']     = 'CodeIgniter\\Session\\Handlers\\FileHandler';
$_ENV['session.cookieName'] = 'hrd_session';
$_ENV['session.expiration'] = '28800';   // 8 jam
$_ENV['session.matchIP']    = 'false';
$_ENV['session.regenerateDestroy'] = 'true';

// session.savePath sengaja TIDAK diisi.
//
// Dibiarkan kosong, CodeIgniter memakai folder writable/session yang berada di
// luar web root. Jangan mengisinya dengan path relatif seperti 'writable/session':
// path relatif dihitung dari direktori kerja PHP, sehingga berkas sesi berpindah
// ke dalam web root dan berpotensi bisa diunduh lewat browser. Isi berkas sesi
// memuat user_id dan role, jadi siapa pun yang membacanya dapat menyamar sebagai
// pengguna yang bersangkutan.

// -------------------------------------------------------------- LOGGER ----
// 1 = error saja, 4 = semua. Di produksi pakai 3 atau lebih kecil.
$_ENV['logger.threshold'] = '3';
