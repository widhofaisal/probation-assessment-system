<?php
/**
 * env.local.php — config override yang aman untuk InfinityFree (putenv() disabled).
 *
 * CARA PAKAI:
 *   1. Copy file ini menjadi `env.local.php`.
 *   2. Letakkan di:
 *        - LOKAL  : di project root (sejajar dengan composer.json) — opsional, lebih lazim pakai .env biasa.
 *        - SERVER : di dalam htdocs/ (sejajar dengan index.php).
 *   3. Edit nilai di bawah sesuai server / DB Anda.
 *   4. JANGAN commit file ini — sudah di-gitignore.
 *
 * File ini di-load oleh public/index.php SEBELUM CI4 boot.
 * Karena meng-isi $_ENV langsung, tidak bergantung pada putenv()/DotEnv.
 */

$_ENV['CI_ENVIRONMENT']            = 'production';

// APP
$_ENV['app.baseURL']               = 'http://your-domain.infinityfreeapp.com/';
$_ENV['app.indexPage']             = '';
$_ENV['app.forceGlobalSecureRequests'] = 'false';
$_ENV['app.CSPEnabled']            = 'false';

// DATABASE
$_ENV['database.default.hostname'] = 'sqlXXX.infinityfree.com';
$_ENV['database.default.database'] = 'if0_XXXXXXX_dbname';
$_ENV['database.default.username'] = 'if0_XXXXXXX';
$_ENV['database.default.password'] = 'YOUR_DB_PASSWORD';
$_ENV['database.default.DBDriver'] = 'MySQLi';
$_ENV['database.default.DBPrefix'] = '';
$_ENV['database.default.port']     = '3306';
$_ENV['database.default.charset']  = 'utf8mb4';
$_ENV['database.default.collation'] = 'utf8mb4_unicode_ci';

// ENCRYPTION
$_ENV['encryption.key']            = 'aQ9bL7xM2pN8kR5cV1jW4tY6uD3fG0hS';

// SESSION
$_ENV['session.driver']            = 'CodeIgniter\\Session\\Handlers\\FileHandler';
$_ENV['session.cookieName']        = 'hrd_session';
$_ENV['session.expiration']        = '28800';
$_ENV['session.matchIP']           = 'false';
$_ENV['session.regenerateDestroy'] = 'true';

// LOGGER
$_ENV['logger.threshold']          = '4';
