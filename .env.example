#--------------------------------------------------------------------
# TEMPLATE KONFIGURASI - Sistem HRD Penilaian Probation
#--------------------------------------------------------------------
#
# Salin file ini menjadi .env lalu isi nilainya:
#
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux / macOS)
#
# JANGAN pernah commit file .env ke git - isinya kredensial.
# File .env sudah terdaftar di .gitignore.
#--------------------------------------------------------------------


#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
# production  : untuk server sungguhan. Error disembunyikan dari pengunjung.
# development : hanya untuk komputer lokal saat ngoding. Menampilkan stack
#               trace lengkap berikut kredensial database di halaman error,
#               jadi JANGAN dipakai di server yang bisa diakses publik.

CI_ENVIRONMENT = production


#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
# baseURL wajib diakhiri garis miring ( / ).
# Contoh lokal    : http://localhost:8080/
# Contoh produksi : https://hrd.perusahaan.co.id/

app.baseURL = 'http://localhost:8080/'

# Set true kalau server sudah memakai HTTPS - memaksa semua akses lewat HTTPS.
app.forceGlobalSecureRequests = false

app.CSPEnabled = false


#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# Buat database kosong terlebih dahulu, lalu import database_dump.sql
# ke dalamnya (lewat phpMyAdmin atau: mysql -u USER -p NAMA_DB < database_dump.sql)

database.default.hostname = localhost
database.default.database = hrd_system
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port     = 3306
database.default.charset  = utf8mb4
database.default.collation = utf8mb4_general_ci


#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------
# WAJIB diisi nilai acak dan unik untuk tiap instalasi. Jangan memakai
# nilai dari instalasi lain, dan jangan dibagikan.
#
# Cara membuat (jalankan di root proyek):
#     php spark key:generate
#
# Perintah di atas otomatis mengisi baris ini di file .env Anda.

encryption.key =


#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver     = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = 'ci_session'
session.expiration = 7200

# session.savePath sengaja TIDAK diisi di sini.
#
# Dibiarkan kosong, CodeIgniter memakai nilai bawaan dari app/Config/Session.php
# yaitu WRITEPATH . 'session' - sebuah path absolut ke folder writable/ yang
# berada DI LUAR folder public/.
#
# Jangan diisi dengan path relatif seperti 'writable/session'. Path relatif
# dihitung dari direktori kerja PHP, yang saat melayani request adalah folder
# public/. Akibatnya file sesi tertulis ke public/writable/session/ - di dalam
# web root - sehingga berpotensi bisa diunduh langsung lewat browser. Isi file
# sesi memuat user_id dan role, jadi siapa pun yang bisa membacanya dapat
# menyamar sebagai pengguna yang bersangkutan.
#
# Kalau memang perlu diarahkan ke tempat lain, gunakan path absolut.
# session.savePath = '/path/absolut/ke/writable/session'


#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
# 1 = error saja, 4 = semua (verbose). Di produksi gunakan 3 atau lebih kecil
# agar file log tidak membengkak.

logger.threshold = 3
